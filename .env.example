# ── LLM APIs ──────────────────────────────────────────────────────────────────
# Required: Groq is the free fallback for generation and eval judging.
# Get a free key at console.groq.com
GROQ_API_KEY=gsk_...

# Optional: keep for future Anthropic integration
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Infrastructure ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base

DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb

REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0

# ── Langfuse Observability ────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ── Models ────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
GENERATION_MODEL=llama-3.1-8b-instant          # Groq fallback (500K TPD)
GENERATION_FALLBACK_MODEL=llama-3.1-8b-instant
CONTEXT_ENRICHMENT_MODEL=llama-3.3-70b-versatile
EVAL_JUDGE_MODEL=llama-3.3-70b-versatile       # Groq fallback (100K TPD)

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=64
CONTEXT_WINDOW_SIZE=8192

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=50
RERANK_TOP_K=8
RRF_K=60
MAX_AGENT_RETRIES=2

# ── Caching ───────────────────────────────────────────────────────────────────
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ── VESSL Cloud GPU (recommended for eval + ingestion enrichment) ─────────────
# Deploy Qwen2.5-14B on a VESSL A100 workspace with vLLM.
# When set, both generation and RAGAS judging route to VESSL first (no TPD limits).
# A full 50-question eval run costs ~$0.40 in A100 GPU time vs. Groq daily exhaustion.
# Leave blank to fall back to Groq.
VESSL_ENDPOINT=
VESSL_TOKEN=
VESSL_MODEL=Qwen/Qwen2.5-14B-Instruct
